# ============================================================
# TELEGRAM BOT - Environment Configuration
# ============================================================

# --- BOT ---
BOT_TOKEN=your_telegram_bot_token_here
BOT_USERNAME=your_bot_username
WEBHOOK_HOST=https://yourdomain.com
WEBHOOK_PATH=/webhook
WEBHOOK_PORT=8443

# --- OPENAI ---
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4-turbo-preview
OPENAI_MAX_TOKENS=4096
OPENAI_TEMPERATURE=0.7

# --- DATABASE ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=botdb
POSTGRES_USER=botuser
POSTGRES_PASSWORD=supersecretpassword
DATABASE_URL=postgresql+asyncpg://botuser:supersecretpassword@postgres:5432/botdb

# --- REDIS ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=redissecret
REDIS_DB=0
REDIS_URL=redis://:redissecret@redis:6379/0

# --- RABBITMQ ---
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=rabbitmq
RABBITMQ_PASSWORD=rabbitmqsecret
RABBITMQ_VHOST=/
RABBITMQ_URL=amqp://rabbitmq:rabbitmqsecret@rabbitmq:5672/

# --- CELERY ---
CELERY_BROKER_URL=amqp://rabbitmq:rabbitmqsecret@rabbitmq:5672/
CELERY_RESULT_BACKEND=redis://:redissecret@redis:6379/1

# --- SECURITY ---
SECRET_KEY=your_very_long_secret_key_here_minimum_32_chars
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
ADMIN_IDS=123456789,987654321

# --- RATE LIMITING ---
RATE_LIMIT_MESSAGES=30
RATE_LIMIT_WINDOW=60
AI_RATE_LIMIT_MESSAGES=10
AI_RATE_LIMIT_WINDOW=60

# --- SCHEDULER ---
NEWS_UPDATE_INTERVAL=15
GITHUB_UPDATE_INTERVAL=60
HABR_UPDATE_INTERVAL=30

# --- LOGGING ---
LOG_LEVEL=INFO
LOG_FORMAT=json

# --- MONITORING ---
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_PASSWORD=grafanasecret

# --- CHANNELS ---
NEWS_CHANNEL_ID=-1001234567890
GITHUB_CHANNEL_ID=-1001234567891
HABR_CHANNEL_ID=-1001234567892

# --- PREMIUM ---
PREMIUM_PRICE=9.99
REFERRAL_BONUS_DAYS=7

# --- APP ---
DEBUG=false
ENVIRONMENT=production
APP_VERSION=1.0.0
